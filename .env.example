# Copy this file to `.env` and adjust. `.env` is never committed.
# Every value has a safe default for local development except in production,
# where DJANGO_DEBUG=False makes DJANGO_SECRET_KEY and DJANGO_ALLOWED_HOSTS
# mandatory (the app refuses to start without them).

# --- Core -----------------------------------------------------------------
# Leave DEBUG on for local work. Turn it OFF for any deployment.
DJANGO_DEBUG=True

# Required when DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# DJANGO_SECRET_KEY=

# Comma-separated. Required when DEBUG is off.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Comma-separated, each with a scheme, e.g. https://veritrade.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database -------------------------------------------------------------
# SQLite is used automatically when POSTGRES_DB is unset. To use PostgreSQL,
# set these and the app switches over with no code change.
# POSTGRES_DB=veritrade
# POSTGRES_USER=veritrade
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Security (only consulted when DEBUG is off) --------------------------
# HTTPS redirect is on by default in production; disable only behind a proxy
# that already enforces it.
# DJANGO_SECURE_SSL_REDIRECT=True
# Set when TLS is terminated by an upstream proxy that sets X-Forwarded-Proto.
# DJANGO_USE_X_FORWARDED_PROTO=True

# --- Email (only consulted when DEBUG is off; console backend in dev) ------
# DJANGO_EMAIL_HOST=
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=noreply@veritrade.local

# --- Marketplace rules ----------------------------------------------------
# VERITRADE_CURRENCY_SYMBOL=₹
# VERITRADE_MAX_TOPUP=100000
# VERITRADE_MAX_UPLOAD_BYTES=5242880
